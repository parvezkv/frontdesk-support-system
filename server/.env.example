# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frontdesk_db?schema=public"

# JWT Secret for Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:5173"
